{
  "id": "/",
  "name": "Homy Property — Temukan hunian terbaik",
  "short_name": "Homy",
  "description": "Marketplace properti Indonesia: cari, jual, sewa rumah, apartemen, ruko, dan tanah. Agen & pemilik properti mengelola listing, prospek, jadwal kunjungan, dan komisi dalam satu platform.",
  "lang": "id",
  "dir": "ltr",
  "scope": "/",
  "start_url": "/?source=pwa",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui", "tabbed"],
  "orientation": "portrait-primary",
  "background_color": "#f7f3ec",
  "theme_color": "#0b3d2e",
  "categories": ["business", "lifestyle", "shopping", "productivity"],
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=id.homyproperty.twa",
      "id": "id.homyproperty.twa"
    }
  ],
  "scope_extensions": [
    { "type": "origin", "origin": "https://homy-coral.vercel.app" },
    { "type": "origin", "origin": "https://v0-homy-property.vercel.app" }
  ],
  "share_target": {
    "action": "/share",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": { "title": "title", "text": "text", "url": "url" }
  },
  "protocol_handlers": [
    { "protocol": "web+homy", "url": "/open?target=%s" }
  ],
  "edge_side_panel": { "preferred_width": 480 },
  "tab_strip": {
    "home_tab": {
      "scope_patterns": [
        { "origin": "https://homyproperty.id", "path": "/" },
        { "origin": "https://homyproperty.id", "path": "/buy" },
        { "origin": "https://homyproperty.id", "path": "/rent" },
        { "origin": "https://homyproperty.id", "path": "/property" },
        { "origin": "https://homyproperty.id", "path": "/dashboard" },
        { "origin": "https://homyproperty.id", "path": "/message" }
      ]
    },
    "new_tab_button": { "url": "/list" }
  },
  "note_taking": { "new_note_url": "/contact?source=note" },
  "file_handlers": [
    { "action": "/open-file", "accept": { "application/pdf": [".pdf"] } }
  ],
  "widgets": [
    {
      "name": "Properti Baru Homy",
      "description": "Lima listing properti terbaru di Homy Property, langsung dari dashboard Windows.",
      "tag": "homy-properti-baru",
      "ms_ac_template": "/widgets/homy-properti.json",
      "data": "/api/widgets/properti-baru",
      "type": "application/json",
      "auth": false,
      "update": 3600,
      "icons": [
        { "src": "/icon-512.png", "sizes": "512x512" }
      ],
      "screenshots": [
        { "src": "/screenshots/homy-mobile.png", "sizes": "1080x1920", "label": "Widget properti terbaru" }
      ]
    }
  ],
  "launch_handler": { "client_mode": ["navigate-existing", "auto"] },
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/apple-icon.png", "sizes": "180x180", "type": "image/png", "purpose": "any" },
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "screenshots": [
    {
      "src": "/screenshots/homy-mobile.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Beranda Homy Property di ponsel — pencarian properti dan rekomendasi pilihan"
    },
    {
      "src": "/screenshots/homy-desktop.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Beranda Homy Property di desktop — jelajahi listing rumah, apartemen, dan tanah"
    }
  ],
  "shortcuts": [
    { "name": "Cari properti dijual", "short_name": "Beli", "url": "/buy?source=pwa", "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Cari properti disewa", "short_name": "Sewa", "url": "/rent?source=pwa", "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Pasang properti", "short_name": "Pasang", "url": "/list?source=pwa", "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Dasbor saya", "short_name": "Dasbor", "url": "/dashboard/user?source=pwa", "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ]
}
